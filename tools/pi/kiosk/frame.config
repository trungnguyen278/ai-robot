# Ubuntu Frame's `config` option for the robot's kiosk (docs/decisions/0021-sleep-and-wake.md).
# tools/pi/kiosk.sh passes Frame the lines that are not comments. Frame writes them into its
# config file and restarts when they change (its configure hook, Frame 457).
#
# No pointer on the screen: it is a touch screen (Frame's choices: auto, null, software).
cursor=null
# Seconds without input, and without a page that holds a wake lock, before the screen turns
# off. The face holds one while the robot is awake, so this is the time from closed eyes to a
# dark screen. It is also how long the screen stays on when no page holds a lock.
idle-timeout=15
# The idle-inhibit protocol, through which Chromium's Screen Wake Lock keeps the screen on.
# Mir supports it but does not offer it by default (Mir 2.26).
add-wayland-extensions=zwp_idle_inhibit_manager_v1
